PORT=3000
DATABASE_PATH=./data/major-neto.sqlite
HOST=127.0.0.1

# Deixe true para testar a interface sem disparar mensagens reais.
DEMO_MODE=true

# WPPConnect Server
WPP_CONNECT_URL=http://localhost:21465
WPP_CONNECT_SESSION=major-neto
WPP_CONNECT_TOKEN=

# Webhook do WPPConnect (entrega, leitura e respostas no dashboard)
# PUBLIC_BASE_URL: URL publica deste servidor (ex.: https://seu-dominio.com), usada para
#   registrar o webhook automaticamente ao conectar um numero.
# WPP_WEBHOOK_SECRET: segredo enviado como ?secret= na URL do webhook; sem ele, o endpoint
#   aceita qualquer chamada (ok apenas em rede fechada/local).
PUBLIC_BASE_URL=
WPP_WEBHOOK_SECRET=

# Meta Graph API / Instagram Content Publishing
META_GRAPH_VERSION=v23.0
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Personalizacao opcional no servidor (nunca coloque o token no frontend)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Bot do Telegram para aprovacao de novos cadastros
# TELEGRAM_BOT_TOKEN: token do BotFather
# TELEGRAM_ADMIN_CHAT_ID: seu chat ID (mande /start para o bot para descobrir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
